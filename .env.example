# Leave blank to use the local scheduling service at /api/schedule/events.
VITE_SCHEDULE_API_URL=

# To use Supabase, set the complete public events URL before building the app:
# VITE_SCHEDULE_API_URL=https://PROJECT.supabase.co/functions/v1/schedule-api/events

# Local Supabase development can use HTTP on a loopback host:
# VITE_SCHEDULE_API_URL=http://127.0.0.1:54321/functions/v1/schedule-api/events

# VITE_ values are public in the browser bundle. This URL needs no Supabase key.
# Never put service-role keys or other secrets in VITE_ variables.
